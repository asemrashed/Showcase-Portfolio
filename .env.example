# --- Database (Neon). Prisma reads .env, so keep these in .env ---
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require"

# --- Auth.js (generate: openssl rand -base64 32) ---
AUTH_SECRET=""
# AUTH_TRUST_HOST=true   # when self-hosting behind a proxy

# --- File storage ---
# "cloudinary" (default) or "s3". Only the active provider's vars below need to be filled in —
# see src/lib/storage/index.ts. Switching later is just flipping this one value.
FILE_UPLOAD_PROVIDER="cloudinary"

# Cloudinary (default provider)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# S3 (used when FILE_UPLOAD_PROVIDER=s3). Also works for any S3-compatible endpoint —
# Cloudflare R2, MinIO, etc. — by setting S3_ENDPOINT.
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_URL="https://cdn.example.com"   # public bucket / custom domain / CDN, no trailing slash
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"   # only for R2/MinIO/etc.
# S3_FORCE_PATH_STYLE="true"                                    # only for MinIO/etc.

# --- Mail (SMTP) — contact form notifications + forgot/reset password ---
# Skipped gracefully (with a console warning) if unset, so local dev doesn't require it.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""                              # for Gmail: an App Password, not your account password
SMTP_FROM="Project Showcase <noreply@example.com>"
CONTACT_TO_EMAIL="you@example.com"        # who receives contact-form notifications

# --- Cron (storage cleanup + soft-delete purge). Vercel sends it as a Bearer token ---
CRON_SECRET=""

# --- Seed ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""   # leave empty to auto-generate and print once

# --- Public site (used for metadataBase / canonical URLs / sitemap / password-reset links) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
